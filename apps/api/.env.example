NODE_ENV=development
PORT=3000
# Origin của web (CORS + cookie). Nhiều origin cách nhau bằng dấu phẩy.
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://waretrack:waretrack@localhost:5433/waretrack?schema=public
# Khóa ký JWT ES256 (PEM, xuống dòng viết \n). Để trống ở dev: API tự sinh cặp khóa vào apps/api/.keys/
# Production (Render): đặt bằng secret của nền tảng — mục 19.1, 19.7.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cookie refresh khác domain với web (Vercel ↔ Render) cần SameSite=None; Secure (mục 12.7)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=waretrack

# Dựng và chạy kịch bản demo giống video (tắt khi chạy smoke test)
DEMO_DIRECTOR=false

# Vận hành thật (DB trống, không seed demo): admin đầu tiên được tạo khi chưa có user nào
# BOOTSTRAP_ADMIN_USERNAME=root.admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
