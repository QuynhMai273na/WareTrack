  receivedAt       DateTime?           @map("received_at") @db.Timestamptz(6)
  storedAt         DateTime?           @map("stored_at") @db.Timestamptz(6)
  releasedAt       DateTime?           @map("released_at") @db.Timestamptz(6)
  exitedAt         DateTime?           @map("exited_at") @db.Timestamptz(6)
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle          StoredVehicle       @relation(fields: [vehicleId], references: [id])
  inspections      VehicleInspection[]
  releaseRequests  ReleaseRequest[]

  // partial unique (vehicle_id) WHERE status active -> SQL migration (BR-14)
  @@index([siteId, status])
  @@map("vehicle_stay")
}

model VehicleInspection {
  id              String           @id @default(uuid(7)) @db.Uuid
  siteId          String           @map("site_id") @db.Uuid
  vehicleStayId   String           @map("vehicle_stay_id") @db.Uuid
  inspectionType  String           @map("inspection_type")
  checklist       Json
  resultCondition VehicleCondition @map("result_condition")
  inspectorId     String?          @map("inspector_id") @db.Uuid
  inspectedAt     DateTime         @default(now()) @map("inspected_at") @db.Timestamptz(6)
  stay            VehicleStay      @relation(fields: [vehicleStayId], references: [id])

  @@index([vehicleStayId])
  @@map("vehicle_inspection")
}

model ReleaseRequest {
  id            String               @id @default(uuid(7)) @db.Uuid
  siteId        String               @map("site_id") @db.Uuid
  vehicleStayId String               @map("vehicle_stay_id") @db.Uuid
  status        ReleaseRequestStatus @default(PENDING)
  reason        String
  recipientName String               @map("recipient_name")
  plannedAt     DateTime?            @map("planned_at") @db.Timestamptz(6)
  requestedById String               @map("requested_by_id") @db.Uuid
  decidedById   String?              @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?              @map("decision_note")
  version       Int                  @default(0)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  stay          VehicleStay          @relation(fields: [vehicleStayId], references: [id])

  @@index([vehicleStayId])
  @@map("release_request")
}

// ───────────────────────── Operations — movement history ─────────────────────────

model MovementRecord {
  id             BigInt          @id @default(autoincrement())
  siteId         String          @map("site_id") @db.Uuid
  subjectType    MovementSubject @map("subject_type")
  subjectId      String          @map("subject_id") @db.Uuid
  fromLocationId String?         @map("from_location_id") @db.Uuid
  toLocationId   String?         @map("to_location_id") @db.Uuid
  positionSource PositionSource  @map("position_source")
  confidence     Decimal?        @db.Decimal(3, 2)
  reason         String
  actorId        String?         @map("actor_id") @db.Uuid
  taskId         String?         @map("task_id") @db.Uuid
  occurredAt     DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, occurredAt(sort: Desc)])
  @@index([siteId, occurredAt(sort: Desc)])
  @@map("movement_record")
}

// ───────────────────────── Notifications (FR-18) ─────────────────────────

/** In-app notification sinh từ event đã commit; idempotent theo (eventId, userId) (mục 13.2 Notifications). */
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  siteId    String?   @map("site_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String    @map("event_id")
  category  String
  severity  String    @default("INFO")
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([eventId, userId], map: "ux_notification_event_user")
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}
