  @@index([siteId, taskType, completedAt])
  @@index([sourceType, sourceId])
  @@map("operation_task")
}

model TaskEvent {
  id         String      @id @default(uuid(7)) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
