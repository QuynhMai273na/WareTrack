// WareTrack — Prisma schema (mục 14). Ràng buộc mà Prisma không biểu đạt được
// (partial unique index, check constraint, trigger) nằm trong SQL migration (mục 14.8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum SiteType {
  DEPOT
  DISTRIBUTION_CENTER
  CROSS_DOCK
  COLD_STORE
  AUTOMATED_DC
  VEHICLE_YARD
  MIXED
}

enum OperationalStatus {
  OPERATIONAL
  LIMITED
  CLOSED
}

enum ZoneType {
  YARD
  WAREHOUSE
  STAGING
  QUARANTINE
  VEHICLE_STORAGE
  GATE_AREA
  CHARGING
}

enum LocationType {
  STORAGE
  PARKING_SLOT
  DOCK
  GATE_LANE
  STAGING
  QUARANTINE
  YARD_SLOT
  CHARGER
}

enum DockDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum LayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LayoutTargetType {
  ZONE
  LOCATION
  BUILDING
  DECOR
}

enum TruckType {
  BOX
  REEFER
  FLATBED
  CAR_CARRIER
  CONTAINER
}

enum VisitDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum TruckVisitStatus {
  SCHEDULED
  AT_GATE
  WAITING
  DOCK_ASSIGNED
  AT_DOCK
  HANDLING
  READY_TO_LEAVE
  EXITED
  REJECTED
  NO_SHOW
  CANCELLED
}

enum ExitReason {
  COMPLETED
  ABORTED
  REJECTED_GOODS
  EMERGENCY
}

enum GateEventType {
  IN_ARRIVAL
  IN_VERIFIED
  OUT
  VEHICLE_IN
  VEHICLE_OUT
  REJECTED
}

enum OccupantType {
  TRUCK_VISIT
  VEHICLE_STAY
  HANDLING_UNIT
  EQUIPMENT
}

enum OccupancyKind {
  RESERVED
  OCCUPIED
}

enum PositionSource {
  CONFIRMED_MANUAL
  CONFIRMED_SCAN
  SENSOR_OBSERVED
  INFERRED
}

enum EquipmentType {
  FORKLIFT
  REACH_TRUCK
  PALLET_JACK
  TUG
}

enum EquipmentStatus {
  OFFLINE
  AVAILABLE
  ASSIGNED
  BUSY
  CHARGING
  MAINTENANCE
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                String         @id @default(uuid(7)) @db.Uuid
  username          String         @unique
  email             String         @unique
  fullName          String         @map("full_name")
  passwordHash      String         @map("password_hash")
  status            UserStatus     @default(ACTIVE)
  failedLoginCount  Int            @default(0) @map("failed_login_count")
  lockedUntil       DateTime?      @map("locked_until") @db.Timestamptz(6)
  permissionVersion Int            @default(0) @map("permission_version")
  lastSiteId        String?        @map("last_site_id") @db.Uuid
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  siteRoles         UserSiteRole[]
  refreshTokens     RefreshToken[]

  @@map("user")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique
  name        String
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  userRoles   UserSiteRole[]

  @@map("role")
}

model Permission {
  id     String           @id @default(uuid(7)) @db.Uuid
  code   String           @unique
  module String
  roles  RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserSiteRole {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  siteId      String?   @map("site_id") @db.Uuid // NULL = toàn doanh nghiệp
  grantedById String?   @map("granted_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])
  site        Site?     @relation(fields: [siteId], references: [id])

  // partial unique (user_id, role_id, site_id) WHERE revoked_at IS NULL -> SQL migration
  @@index([userId])
  @@map("user_site_role")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@map("refresh_token")
}

// ───────────────────────── Sites & Layout ─────────────────────────

model Site {
  id                String            @id @default(uuid(7)) @db.Uuid
  code              String
  name              String
  siteType          SiteType          @map("site_type")
  addressLine       String?           @map("address_line")
  timezone          String
  /** Vị trí của site trên bản đồ mạng lưới chung (mét, hệ tọa độ thế giới của scene 3D) */
  mapX              Float             @default(0) @map("map_x")
  mapZ              Float             @default(0) @map("map_z")
  operationalStatus OperationalStatus @default(OPERATIONAL) @map("operational_status")
  version           Int               @default(0)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  zones             Zone[]
  locations         Location[]
  settings          SiteSetting[]
  layouts           LayoutVersion[]
  userRoles         UserSiteRole[]

  // partial unique (code) WHERE deleted_at IS NULL -> SQL migration
  @@map("site")
}

model SiteSetting {
  siteId    String   @map("site_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  site      Site     @relation(fields: [siteId], references: [id])

  @@id([siteId, key])
  @@map("site_setting")
}

model Zone {
  id        String     @id @default(uuid(7)) @db.Uuid
  siteId    String     @map("site_id") @db.Uuid
  code      String
  name      String
  zoneType  ZoneType   @map("zone_type")
  version   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  site      Site       @relation(fields: [siteId], references: [id])
  locations Location[]

  @@index([siteId])
  @@map("zone")
}

model Location {
  id              String              @id @default(uuid(7)) @db.Uuid
  siteId          String              @map("site_id") @db.Uuid
  zoneId          String              @map("zone_id") @db.Uuid
  code            String
  /** Tên hiển thị (Bay 1, Yard slot S01…) */
  name            String?
  qrValue         String              @unique @map("qr_value")
  locationType    LocationType        @map("location_type")
  capacityUnits   Decimal             @default(1) @map("capacity_units") @db.Decimal(10, 2)
  maxWeightKg     Decimal?            @map("max_weight_kg") @db.Decimal(10, 2)
  singleOccupancy Boolean             @default(true) @map("single_occupancy")
  lengthM         Decimal?            @map("length_m") @db.Decimal(6, 2)
  widthM          Decimal?            @map("width_m") @db.Decimal(6, 2)
  isActive        Boolean             @default(true) @map("is_active")
  blockedAt       DateTime?           @map("blocked_at") @db.Timestamptz(6)
  blockedReason   String?             @map("blocked_reason")
  frozenByCountId String?             @map("frozen_by_count_id") @db.Uuid
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  site            Site                @relation(fields: [siteId], references: [id])
  zone            Zone                @relation(fields: [zoneId], references: [id])
  dock            Dock?
  occupancies     LocationOccupancy[]

  @@index([siteId, zoneId, locationType])
  @@map("location")
}

model Dock {
  locationId      String        @id @map("location_id") @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  direction       DockDirection
  doorNumber      String?       @map("door_number")
  maxTruckLengthM Decimal?      @map("max_truck_length_m") @db.Decimal(6, 2)
  location        Location      @relation(fields: [locationId], references: [id])

  @@map("dock")
}

model LayoutVersion {
  id            String         @id @default(uuid(7)) @db.Uuid
  siteId        String         @map("site_id") @db.Uuid
  versionNo     Int            @map("version_no")
  status        LayoutStatus   @default(DRAFT)
  modelFileId   String?        @map("model_file_id") @db.Uuid
  boundsMinX    Float          @default(0) @map("bounds_min_x")
  boundsMinZ    Float          @default(0) @map("bounds_min_z")
  boundsMaxX    Float          @default(100) @map("bounds_max_x")
  boundsMaxZ    Float          @default(100) @map("bounds_max_z")
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(6)
  publishedById String?        @map("published_by_id") @db.Uuid
  version       Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  site          Site           @relation(fields: [siteId], references: [id])
  objects       LayoutObject[]

  @@unique([siteId, versionNo])
  @@map("layout_version")
}

model LayoutObject {
  id              String           @id @default(uuid(7)) @db.Uuid
  layoutVersionId String           @map("layout_version_id") @db.Uuid
  targetType      LayoutTargetType @map("target_type")
  targetId        String?          @map("target_id") @db.Uuid
  meshRef         String?          @map("mesh_ref")
  posX            Float            @map("pos_x")
  posY            Float            @default(0) @map("pos_y")
  posZ            Float            @map("pos_z")
  rotY            Float            @default(0) @map("rot_y")
  sizeX           Float            @default(1) @map("size_x")
  sizeY           Float            @default(1) @map("size_y")
  sizeZ           Float            @default(1) @map("size_z")
  props           Json?
  layoutVersion   LayoutVersion    @relation(fields: [layoutVersionId], references: [id], onDelete: Cascade)

  @@index([layoutVersionId])
  @@map("layout_object")
}

model Partner {
  id           String    @id @default(uuid(7)) @db.Uuid
  code         String
  name         String
  partnerTypes String[]  @map("partner_types")
  contact      Json?
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  trucks       Truck[]
  drivers      Driver[]

  @@map("partner")
}

// ───────────────────────── Yard ─────────────────────────

model Truck {
  id          String       @id @default(uuid(7)) @db.Uuid
  code        String
  plateNumber String       @map("plate_number")
  carrierId   String?      @map("carrier_id") @db.Uuid
  truckType   TruckType    @map("truck_type")
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  carrier     Partner?     @relation(fields: [carrierId], references: [id])
  visits      TruckVisit[]

  @@map("truck")
}

model Driver {
  id            String       @id @default(uuid(7)) @db.Uuid
  fullName      String       @map("full_name")
  licenseNumber String?      @map("license_number")
  phone         String?
  carrierId     String?      @map("carrier_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  carrier       Partner?     @relation(fields: [carrierId], references: [id])
  visits        TruckVisit[]

  @@map("driver")
}

model TruckVisit {
  id                String           @id @default(uuid(7)) @db.Uuid
  siteId            String           @map("site_id") @db.Uuid
  code              String           @unique
  truckId           String           @map("truck_id") @db.Uuid
  driverId          String?          @map("driver_id") @db.Uuid
  direction         VisitDirection
  status            TruckVisitStatus
  unscheduled       Boolean          @default(false)
  appointmentStart  DateTime?        @map("appointment_start") @db.Timestamptz(6)
  appointmentEnd    DateTime?        @map("appointment_end") @db.Timestamptz(6)
  etaAt             DateTime?        @map("eta_at") @db.Timestamptz(6)
  arrivedAt         DateTime?        @map("arrived_at") @db.Timestamptz(6)
  verifiedAt        DateTime?        @map("verified_at") @db.Timestamptz(6)
  dockedAt          DateTime?        @map("docked_at") @db.Timestamptz(6)
  handlingStartedAt DateTime?        @map("handling_started_at") @db.Timestamptz(6)
  readyAt           DateTime?        @map("ready_at") @db.Timestamptz(6)
  exitedAt          DateTime?        @map("exited_at") @db.Timestamptz(6)
  dockLocationId    String?          @map("dock_location_id") @db.Uuid
  actualPlate       String?          @map("actual_plate")
  sealIn            String?          @map("seal_in")
  sealOut           String?          @map("seal_out")
  exitReason        ExitReason?      @map("exit_reason")
  rejectReason      String?          @map("reject_reason")
  lateReason        String?          @map("late_reason")
  version           Int              @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?          @map("created_by_id") @db.Uuid
  truck             Truck            @relation(fields: [truckId], references: [id])
  driver            Driver?          @relation(fields: [driverId], references: [id])
  gateEvents        GateEvent[]

  // partial unique (truck_id) WHERE status active -> SQL migration (BR-13)
  @@index([siteId, status])
  @@index([siteId, appointmentStart])
  @@map("truck_visit")
}

model GateEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  siteId         String        @map("site_id") @db.Uuid
  eventType      GateEventType @map("event_type")
  truckVisitId   String?       @map("truck_visit_id") @db.Uuid
  vehicleStayId  String?       @map("vehicle_stay_id") @db.Uuid
  gateLocationId String?       @map("gate_location_id") @db.Uuid
  plateRead      String?       @map("plate_read")
  note           String?
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId        String?       @map("actor_id") @db.Uuid
  truckVisit     TruckVisit?   @relation(fields: [truckVisitId], references: [id])

  @@index([siteId, occurredAt])
  @@map("gate_event")
}

model LocationOccupancy {
  id              String          @id @default(uuid(7)) @db.Uuid
  siteId          String          @map("site_id") @db.Uuid
  locationId      String          @map("location_id") @db.Uuid
  occupantType    OccupantType    @map("occupant_type")
  occupantId      String          @map("occupant_id") @db.Uuid
  kind            OccupancyKind
  singleOccupancy Boolean         @map("single_occupancy")
  unitsUsed       Decimal         @default(1) @map("units_used") @db.Decimal(10, 2)
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  occupiedAt      DateTime?       @map("occupied_at") @db.Timestamptz(6)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(6)
  releasedAt      DateTime?       @map("released_at") @db.Timestamptz(6)
  positionSource  PositionSource? @map("position_source")
  createdById     String?         @map("created_by_id") @db.Uuid
  location        Location        @relation(fields: [locationId], references: [id])

  // partial unique indexes BR-01, BR-12 -> SQL migration
  @@index([occupantType, occupantId, startedAt(sort: Desc)])
  @@map("location_occupancy")
}

// ───────────────────────── Equipment ─────────────────────────

model Equipment {
  id                String          @id @default(uuid(7)) @db.Uuid
  siteId            String          @map("site_id") @db.Uuid
  code              String
  equipmentType     EquipmentType   @map("equipment_type")
  model             String?
  status            EquipmentStatus @default(OFFLINE)
  chargerLocationId String?         @map("charger_location_id") @db.Uuid
  currentOperatorId String?         @map("current_operator_id") @db.Uuid
  telemetry         Json?
  telemetryAt       DateTime?       @map("telemetry_at") @db.Timestamptz(6)
  telemetrySource   PositionSource? @map("telemetry_source")
  taskSummary       String?         @map("task_summary")
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)

  @@index([siteId, status])
  @@map("equipment")
}

// ───────────────────────── Platform ─────────────────────────

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  siteId        String?   @map("site_id") @db.Uuid
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id") @db.Uuid
  action        String
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  diff          Json?
  reason        String?
  correlationId String?   @map("correlation_id")
  ip            String?
  userAgent     String?   @map("user_agent")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([siteId, occurredAt(sort: Desc)])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

model OutboxEvent {
  id               BigInt    @id @default(autoincrement())
  eventId          String    @unique @map("event_id") @db.Uuid
  siteId           String    @map("site_id") @db.Uuid
  eventType        String    @map("event_type")
  eventVersion     Int       @default(1) @map("event_version")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id")
  aggregateVersion Int       @map("aggregate_version")
  payload          Json
  correlationId    String?   @map("correlation_id")
  siteSeq          BigInt?   @map("site_seq")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_event")
}

model SiteEventCursor {
  siteId  String @id @map("site_id") @db.Uuid
  lastSeq BigInt @default(0) @map("last_seq")

  @@map("site_event_cursor")
}

model IdempotencyRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String
  userId         String   @map("user_id") @db.Uuid
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([userId, key])
  @@map("idempotency_record")
}

/// Bộ đếm sinh mã nghiệp vụ dễ đọc theo phạm vi (ví dụ "VIS-261010", "TSK-WH-01") — DEC-07.
model CodeCounter {
  scope String @id
  value BigInt @default(0)

  @@map("code_counter")
}

// ───────────────────────── Inventory (Phase 3) ─────────────────────────

enum StockStatus {
  AVAILABLE
  QC_HOLD
  QUARANTINE
  DAMAGED
}

enum AllocationStrategy {
  FIFO
  FEFO
}

enum HuLifecycle {
  RECEIVING
  IN_STOCK
  PICKED
  STAGED
  LOADED
  DISPATCHED
  EMPTY
}

enum SerialStatus {
  IN_STOCK
  PICKED
  SHIPPED
  QUARANTINE
  SCRAPPED
}

enum InventoryTxType {
  RECEIPT
  RECEIPT_REVERSAL
  MOVE
  STATUS_CHANGE
  ISSUE
  ISSUE_REVERSAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ReservationStatus {
  ACTIVE
  PICKED
  CONSUMED
  RELEASED
}

enum StockCountStatus {
  PLANNED
  IN_PROGRESS
  RECONCILING
  COMPLETED
  CANCELLED
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPLIED
  REJECTED
}

enum AdjustmentReason {
  COUNT_VARIANCE
  DAMAGE
  LOSS
  FOUND
  DATA_CORRECTION
}

enum MovementSubject {
  HANDLING_UNIT
  VEHICLE_STAY
  TRUCK_VISIT
  EQUIPMENT
}

model Sku {
  id                 String             @id @default(uuid(7)) @db.Uuid
  code               String
  name               String
  /** Nhóm hàng hiển thị (PPE, Packaging, Electronics…) */
  category           String?
  baseUom            String             @default("EA") @map("base_uom")
  uomDecimals        Int                @default(0) @map("uom_decimals")
  lotTracked         Boolean            @default(false) @map("lot_tracked")
  serialTracked      Boolean            @default(false) @map("serial_tracked")
  expiryTracked      Boolean            @default(false) @map("expiry_tracked")
  qcRequired         Boolean            @default(false) @map("qc_required")
  allocationStrategy AllocationStrategy @default(FIFO) @map("allocation_strategy")
  unitWeightKg       Decimal?           @map("unit_weight_kg") @db.Decimal(10, 3)
  lowStockThreshold  Decimal?           @map("low_stock_threshold") @db.Decimal(18, 3)
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  lots               Lot[]

  @@map("sku")
