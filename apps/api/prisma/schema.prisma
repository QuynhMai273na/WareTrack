  supplierId  String?            @map("supplier_id") @db.Uuid
  status      InboundOrderStatus @default(DRAFT)
  expectedOn  DateTime?          @map("expected_on") @db.Date
  shipmentId  String?            @map("shipment_id") @db.Uuid
  version     Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  lines       InboundOrderLine[]

  @@unique([siteId, code], map: "ux_inbound_order_code")
  @@index([siteId, status])
  @@map("inbound_order")
}

model InboundOrderLine {
  id                String       @id @default(uuid(7)) @db.Uuid
