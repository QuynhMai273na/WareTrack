  @@unique([siteId, code], map: "ux_outbound_order_code")
  @@index([siteId, status])
  @@map("outbound_order")
}

model OutboundOrderLine {
  id              String          @id @default(uuid(7)) @db.Uuid
  outboundOrderId String          @map("outbound_order_id") @db.Uuid
  siteId          String          @map("site_id") @db.Uuid
  skuId           String          @map("sku_id") @db.Uuid
  lotId           String?         @map("lot_id") @db.Uuid
